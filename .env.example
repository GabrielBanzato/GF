# Nome da assistente (aparece na interface e no prompt da IA)
ASSISTANT_NAME=Zeni

PORT=3000

# --- Qwen ---------------------------------------------------------------
# Chave da Alibaba Cloud Model Studio (DashScope). https://modelstudio.console.alibabacloud.com
QWEN_API_KEY=

# Endpoint compatível com OpenAI.
#   DashScope internacional: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Qwen self-hosted (Ollama): http://localhost:11434/v1   (QWEN_API_KEY pode ficar vazio)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Modelo que entende os comandos (precisa suportar function calling)
QWEN_CHAT_MODEL=qwen-plus

# Reconhecimento de voz (detecta o idioma sozinho). Deixe vazio para usar o reconhecimento do navegador.
QWEN_ASR_MODEL=qwen3-asr-flash

# Síntese de voz. Deixe vazio para usar a voz do próprio aparelho.
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_VOICE_FEMALE=Cherry
QWEN_VOICE_MALE=Ethan

# --- E-mail (código de "esqueci minha senha") ----------------------------
# Chave do https://resend.com. Sem ela, o código aparece no log do servidor.
RESEND_API_KEY=
# Remetente (o domínio precisa estar verificado no Resend)
EMAIL_FROM=Zeni <onboarding@resend.dev>
